{
  "name": "canvas-cut-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop generative video creation tool",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "test": "tsc -b --force packages/core apps/cli packages/agent apps/desktop && node --test --test-timeout=30000 tests/*.test.mjs",
    "start:desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-desktop.ps1",
    "dev:desktop:app": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-desktop.ps1",
    "dev:desktop": "npm run dev --workspace @canvas-cut/desktop",
    "dev:cli": "npm run dev --workspace @canvas-cut/cli",
    "build:core": "npm run build --workspace @canvas-cut/core",
    "build:cli": "npm run build --workspace @canvas-cut/cli",
    "build:agent": "npm run build --workspace @canvas-cut/agent",
    "build:desktop": "npm run build --workspace @canvas-cut/desktop"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.43",
    "ai": "^7.0.68",
    "zod": "^4.4.3"
  }
}
